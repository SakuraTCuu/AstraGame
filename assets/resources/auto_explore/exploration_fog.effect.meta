  "compiledShaders": [
    {
      "glsl1": {
        "vert": "\nprecision highp float;\nuniform mat4 cc_matViewProj;\nuniform mat4 cc_matWorld;\nattribute vec3 a_position;\nattribute vec2 a_uv0;\nvarying vec2 v_uv;\nvoid main () {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matWorld * position;\n  #endif\n  gl_Position = cc_matViewProj * position;\n  v_uv = a_uv0;\n}",
        "frag": "\nprecision highp float;\nvarying vec2 v_uv;\nuniform sampler2D texture;\nuniform sampler2D fogTexture;\nuniform vec4 worldRect;\nuniform vec4 grid;\nuniform vec4 light;\nuniform vec4 beam;\nvoid main () {\n  vec2 world = worldRect.xy + vec2(v_uv.x, 1.0 - v_uv.y) * worldRect.zw;\n  vec2 cell = world / grid.z;\n  vec2 fogUv = cell / grid.xy;\n  float explored = texture2D(fogTexture, fogUv).r;\n  float locked = texture2D(fogTexture, fogUv).g;\n  vec2 offset = world - light.xy;\n  float distanceToLight = length(offset);\n  float radial = 1.0 - smoothstep(light.z * 0.65, light.z, distanceToLight);\n  float direction = dot(offset / max(distanceToLight, 0.01), normalize(beam.xy));\n  float cone = smoothstep(beam.w, min(0.999, beam.w + 0.1), direction);\n  cone *= 1.0 - smoothstep(beam.z * 0.45, beam.z, distanceToLight);\n  cone *= light.w;\n  float visibility = max(radial, cone);\n  float alpha = mix(mix(0.96, 0.5, explored), 0.02, visibility);\n  alpha = max(alpha, smoothstep(0.02, 0.5, locked));\n  vec3 tint = mix(vec3(0.025, 0.035, 0.045), vec3(0.1, 0.1, 0.07), cone * 0.2);\n  gl_FragColor = vec4(tint, alpha * texture2D(texture, v_uv).a);\n}"
      },
      "glsl3": {
        "vert": "\nprecision highp float;\nuniform CCGlobal {\n  mat4 cc_matView;\n  mat4 cc_matViewInv;\n  mat4 cc_matProj;\n  mat4 cc_matProjInv;\n  mat4 cc_matViewProj;\n  mat4 cc_matViewProjInv;\n  vec4 cc_cameraPos;\n  vec4 cc_time;\n  mediump vec4 cc_screenSize;\n  mediump vec4 cc_screenScale;\n};\nuniform CCLocal {\n  mat4 cc_matWorld;\n  mat4 cc_matWorldIT;\n};\nin vec3 a_position;\nin vec2 a_uv0;\nout vec2 v_uv;\nvoid main () {\n  vec4 position = vec4(a_position, 1.0);\n  #if CC_USE_MODEL\n    position = cc_matWorld * position;\n  #endif\n  gl_Position = cc_matViewProj * position;\n  v_uv = a_uv0;\n}",
        "frag": "\nprecision highp float;\nin vec2 v_uv;\nuniform sampler2D texture;\nuniform sampler2D fogTexture;\nuniform Fog {\n  vec4 worldRect;\n  vec4 grid;\n  vec4 light;\n  vec4 beam;\n};\nvoid main () {\n  vec2 world = worldRect.xy + vec2(v_uv.x, 1.0 - v_uv.y) * worldRect.zw;\n  vec2 cell = world / grid.z;\n  vec2 fogUv = cell / grid.xy;\n  float explored = texture(fogTexture, fogUv).r;\n  float locked = texture(fogTexture, fogUv).g;\n  vec2 offset = world - light.xy;\n  float distanceToLight = length(offset);\n  float radial = 1.0 - smoothstep(light.z * 0.65, light.z, distanceToLight);\n  float direction = dot(offset / max(distanceToLight, 0.01), normalize(beam.xy));\n  float cone = smoothstep(beam.w, min(0.999, beam.w + 0.1), direction);\n  cone *= 1.0 - smoothstep(beam.z * 0.45, beam.z, distanceToLight);\n  cone *= light.w;\n  float visibility = max(radial, cone);\n  float alpha = mix(mix(0.96, 0.5, explored), 0.02, visibility);\n  alpha = max(alpha, smoothstep(0.02, 0.5, locked));\n  vec3 tint = mix(vec3(0.025, 0.035, 0.045), vec3(0.1, 0.1, 0.07), cone * 0.2);\n  gl_FragColor = vec4(tint, alpha * texture(texture, v_uv).a);\n}"
